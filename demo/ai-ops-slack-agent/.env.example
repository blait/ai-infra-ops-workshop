# 복사해서 사용: cp .env.example .env   (.env는 .gitignore에 있음. 비밀값은 여기에 쓰지 말고 .env에만)

# ---- 실행 모드 ------------------------------------------------------------
# mock: fixtures/checkout-incident 의 장애 데이터를 재생 (AWS 호출 없음, 리허설·평가용)
# aws : 실제 읽기 전용 boto3 호출 (iam/agent-readonly-policy.json 권한, config/services.toml 필요)
AIOPS_MODE=mock
# AIOPS_TARGET_REGION=ap-northeast-2        # aws 모드에서 조사할 워크로드 리전 (필수)
# AIOPS_SERVICES_FILE=config/services.toml  # aws 모드 서비스 정의 (services.example.toml 복사)

# ---- 모델: Amazon Bedrock (Claude Code CLI가 Bedrock으로 호출) ----------------
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
# 모델 고정(권장). 고정하지 않으면 Claude Code 기본값(Opus 5.5)으로 과금됩니다.
# 서울(ap-northeast-2)에서는 global. 프로파일만 최신 모델을 제공 → 데이터 처리 위치를 고객과 확인
AIOPS_MODEL=global.anthropic.claude-sonnet-5-5
# AIOPS_SCOUT_MODEL=inherit                 # 하위 에이전트 모델(기본: 주 모델과 같음)
# AIOPS_EVALUATOR_MODEL=global.anthropic.claude-sonnet-5-5
# AWS_PROFILE=aiops-agent                   # 에이전트(읽기 전용 + bedrock:InvokeModel) 프로필

# ---- Slack (Socket Mode) ---------------------------------------------------
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME
# 승인자 Slack 사용자 ID(쉼표 구분). 비어 있으면 모든 승인 클릭이 거부됩니다.
AIOPS_APPROVERS=UXXXXXXXXXX
# AIOPS_REQUIRE_DISTINCT_APPROVER=1         # 요청자 본인 승인 금지(2인 원칙)
# AIOPS_APPROVAL_TTL_MINUTES=30

# ---- 실행기 (승인 후 SSM Automation) — aws 모드 ------------------------------
# 에이전트와 다른 자격 증명. iam/approver-executor-policy.json 권한
# AIOPS_EXECUTOR_PROFILE=aiops-executor
# AIOPS_AUTOMATION_ASSUME_ROLE_ARN=         # 예: aiops-automation-restart 역할 ARN (iam/automation-assume-role-policy.json)
# AIOPS_VERIFY_WAIT_SECONDS=300             # aws 모드 기본 300초 대기 후 지표 확인

# ---- 기타 ------------------------------------------------------------------
# AIOPS_WORKFLOW_LLM=1                      # 리포트 요약 LLM 단계(게이트 통과 시만 사용). 0이면 템플릿
# AIOPS_MAX_TURNS=16
# AIOPS_MAX_BUDGET_USD=1.50                 # 요청 1건당 SDK 비용 상한
# AIOPS_TOOL_OUTPUT_MAX_CHARS=3500
# AIOPS_DATA_DIR=var
# AIOPS_LOG_LEVEL=INFO

# ---- 배포 모드 (infra/ CDK가 AgentCore Runtime·Lambda 환경 변수로 넣음. 로컬 .env에는 넣지 않음) ----
# AIOPS_GATEWAY_URL / AIOPS_GATEWAY_TARGETS  도구를 AgentCore Gateway(SigV4 + Cedar)로 보냄
# AIOPS_MEMORY_ID                            스레드 노트를 AgentCore Memory에 저장·복원
# AIOPS_MOCK_INSTANCE_MAP=i-fixture=i-real   픽스처 인스턴스 ID를 실제 데모 인스턴스로 바꿔 읽음
# AIOPS_AUDIT_STDOUT=1                       감사 레코드를 stdout(CloudWatch Logs)에도 출력
# AIOPS_SLACK_DRY_RUN=1                      Slack API 대신 보낼 메시지를 로그로 (Lambda)
